FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/survey-ai-api ./cmd/api

FROM alpine:3.20

WORKDIR /app

COPY --from=builder /out/survey-ai-api /app/survey-ai-api

EXPOSE 8080

ENTRYPOINT ["/app/survey-ai-api"]
